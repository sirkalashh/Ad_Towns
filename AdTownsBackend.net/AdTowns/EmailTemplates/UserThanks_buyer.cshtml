@model AdTowns.Services.Email.MailKitEmailSender.RegistrationEmailModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Confirmed</title>
</head>
<body style="margin:0; padding:0; background-color:#121212; color:#ffffff; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <div style="display:none; max-height:0px; overflow:hidden;">
        Thank you for joining AdTowns. Your registration is confirmed.
    </div>
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color:#121212;">
        <tr>
            <td align="center" style="padding: 40px 10px;">
                <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color:#1e1e1e; border-radius:12px; overflow:hidden; border:1px solid #333333;">
                    <tr>
                        <td align="center" style="padding: 40px 20px; background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); border-bottom: 2px solid #00f2fe;">
                            <h1 style="margin:0; font-size: 28px; font-weight:700; color:#ffffff; letter-spacing:1px;">Welcome to AdTowns</h1>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 40px 30px;">
                            <h2 style="margin-top:0; font-size:22px; color:#ffffff;">Hi @Model.Name,</h2>
                            <p style="font-size:16px; line-height:1.6; color:#cccccc;">
                                Thank you for your interest in joining AdTowns! Your registration has been successfully confirmed.
                            </p>
                            
                            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin: 30px 0;">
                                <tr>
                                    <td align="center" style="padding: 20px; background-color: #2a2a2a; border-radius: 8px; border: 1px solid #444;">
                                        <p style="margin: 0; font-size: 14px; color: #aaaaaa; text-transform: uppercase; letter-spacing: 1px;">Reference ID</p>
                                        <h3 style="margin: 10px 0 0 0; font-size: 24px; color: #00f2fe; letter-spacing: 2px;">@Model.ReferenceId</h3>
                                    </td>
                                </tr>
                            </table>

                            <p style="font-size:16px; line-height:1.6; color:#cccccc;">
                                <strong>What happens next?</strong><br>
                                We’ll share curated options and get you set up on the platform.
                            </p>
                            
                            @if (!string.IsNullOrWhiteSpace(Model.Business))
                            {
                                <p style="font-size:15px; color:#999999; margin-top:20px;">
                                    <strong>Business:</strong> @Model.Business
                                </p>
                            }
                            
                            @if (!string.IsNullOrWhiteSpace(Model.Message))
                            {
                                <p style="font-size:15px; color:#999999;">
                                    <strong>Message:</strong> @Model.Message
                                </p>
                            }

                            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top: 40px;">
                                <tr>
                                    <td align="center">
                                        <a href="https://adtowns.com" style="display:inline-block; padding:15px 30px; background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%); color:#ffffff; text-decoration:none; font-size:16px; font-weight:bold; border-radius:30px; text-transform:uppercase;">Visit AdTowns</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding: 20px; background-color:#1a1a1a; font-size:12px; color:#666666;">
                            &copy; @DateTime.UtcNow.Year AdTowns. All rights reserved.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>