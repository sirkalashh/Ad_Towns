public class OfferWindowService
{
    // IST = UTC+5:30
    private static readonly TimeZoneInfo IstZone = 
        TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
    
    public (DateTime StartsAt, DateTime ExpiresAt) 
        GetCurrentOfferWindow()
    {
        var nowIst = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.UtcNow, IstZone);
        
        // Offer window: 8:00 AM IST today → 8:00 AM IST tomorrow
        var todayAt8Am = nowIst.Date.AddHours(8);
        
        DateTime windowStart, windowEnd;
        
        if (nowIst.TimeOfDay >= TimeSpan.FromHours(8))
        {
            // After 8AM: current window
            windowStart = todayAt8Am;
            windowEnd = todayAt8Am.AddDays(1);
        }
        else
        {
            // Before 8AM: previous window still active
            windowStart = todayAt8Am.AddDays(-1);
            windowEnd = todayAt8Am;
        }
        
        return (
            TimeZoneInfo.ConvertTimeToUtc(windowStart, IstZone),
            TimeZoneInfo.ConvertTimeToUtc(windowEnd, IstZone)
        );
    }
    
    public DateTime GetNextWindowStart()
    {
        var (_, currentEnd) = GetCurrentOfferWindow();
        return currentEnd;
    }
}
