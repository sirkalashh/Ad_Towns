public class ImpersonationMiddleware
{
    public async Task InvokeAsync(HttpContext context)
    {
        var user = context.User;
        
        if (user.HasClaim("isImpersonating", "true"))
        {
            var adminId = int.Parse(user.FindFirst("impersonatingAdmin")!.Value);
            var sellerId = int.Parse(user.FindFirst("sub")!.Value);
            
            // Auto-log every impersonated action
            await _auditService.LogAsync(new AuditLogEntry
            {
                ActorType = "Admin",
                ActorId = adminId,
                ImpersonatingId = sellerId,
                Action = context.Request.Path,
                EntityType = "ImpersonatedRequest",
                OccurredAt = DateTime.UtcNow
            });
        }
        
        await _next(context);
    }
}
