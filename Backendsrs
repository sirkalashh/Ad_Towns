public class UpgradeCalculatorService
{
    public UpgradeQuote CalculateUpgrade(
        Shop currentShop, 
        decimal currentFloorPrice,
        decimal targetFloorPrice)
    {
        var remainingDays = (currentShop.EndDate - DateTime.UtcNow).Days;
        var totalDays = (currentShop.EndDate - currentShop.StartDate).Days;
        
        // Daily rate
        var currentDailyRate = currentFloorPrice / 30;
        var targetDailyRate = targetFloorPrice / 30;
        
        // Credit from current plan (what's left)
        var creditAmount = currentDailyRate * remainingDays;
        
        // Cost of new plan for remaining days
        var newPlanCost = targetDailyRate * remainingDays;
        
        // Upgrade cost = difference
        var upgradeCost = Math.Max(0, newPlanCost - creditAmount);
        
        var gst = upgradeCost * 0.18m;
        var total = upgradeCost + gst;
        
        return new UpgradeQuote
        {
            RemainingDays = remainingDays,
            CreditAmount = Math.Round(creditAmount, 2),
            NewPlanCost = Math.Round(newPlanCost, 2),
            UpgradeCost = Math.Round(upgradeCost, 2),
            GstAmount = Math.Round(gst, 2),
            TotalPayable = Math.Round(total, 2)
        };
    }
}
