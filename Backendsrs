7.4 Audit Log Integrity
csharp
public class AuditLogService
{
    // Chained hash for tamper detection
    public async Task LogAsync(AuditLogEntry entry)
    {
        // Get hash of previous log
        var lastLog = await _auditRepo.GetLastLogAsync();
        var previousHash = lastLog?.LogHash ?? "GENESIS";
        
        // Build content to hash
        var content = $"{entry.ActorId}|{entry.Action}|" +
                      $"{entry.EntityType}|{entry.EntityId}|" +
                      $"{entry.OccurredAt:O}|{entry.NewValues}|" +
                      $"{previousHash}";
        
        // SHA256 hash
        entry.LogHash = ComputeSha256(content);
        entry.PreviousLogHash = previousHash;
        
        await _auditRepo.InsertAsync(entry);
        // Note: AuditLog table has no UPDATE/DELETE triggers
    }
    
    private string ComputeSha256(string input)
    {
        using var sha = SHA256.Create();
        var bytes = sha.ComputeHash(Encoding.UTF8.GetBytes(input));
        return Convert.ToHexString(bytes).ToLower();
    }
}
