public class PixelLockService
{
    private readonly IRedisService _redis;
    private readonly IPixelRepository _pixelRepo;
    private readonly IHubContext<BuyerHub> _buyerHub;
    
    private const int LockDurationSeconds = 300; // 5 minutes
    private const string LockKeyPrefix = "pixel:lock:";
    
    public async Task<LockResult> TryLockPixelAsync(
        int pixelId, int sellerId)
    {
        var lockKey = $"{LockKeyPrefix}{pixelId}";
        var lockValue = sellerId.ToString();
        
        // Redis SET NX EX — atomic operation
        // NX = only set if not exists
        // EX = expire in N seconds
        var locked = await _redis.SetNxAsync(
            lockKey, lockValue, TimeSpan.FromSeconds(LockDurationSeconds));
        
        if (!locked)
        {
            // Get next available pixels for helpful error
            var alternatives = await _pixelRepo
                .GetNearbyAvailablePixelsAsync(pixelId, count: 3);
            
            return LockResult.Failed(alternatives);
        }
        
        // Update DB (for recovery after Redis restart)
        await _pixelRepo.UpdateLockAsync(
            pixelId, sellerId, 
            DateTime.UtcNow.AddSeconds(LockDurationSeconds));
        
        // Notify all buyers watching this city/category
        await _buyerHub.Clients.Group($"grid:{cityId}:{categoryId}")
            .SendAsync("PixelLocked", new { pixelId });
        
        var lockToken = GenerateLockToken(pixelId, sellerId);
        return LockResult.Success(lockToken, LockDurationSeconds);
    }
    
    public async Task<bool> ValidateLockTokenAsync(
        string lockToken, int pixelId, int sellerId)
    {
        var lockKey = $"{LockKeyPrefix}{pixelId}";
        var storedSellerId = await _redis.GetAsync(lockKey);
        return storedSellerId == sellerId.ToString() 
            && ValidateToken(lockToken, pixelId, sellerId);
    }
}
