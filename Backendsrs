11.1 Atomic Pixel Purchase Completion
SQL
CREATE PROCEDURE sp_CompletePixelPurchase
    @TransactionId INT,
    @RazorpayPaymentId NVARCHAR(100),
    @RazorpaySignature NVARCHAR(500),
    @PixelId INT,
    @SellerId INT,
    @DurationMonths INT,
    @StartDate DATETIME2,
    @PointsRedeemed INT = 0
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRANSACTION;
    
    BEGIN TRY
        -- 1. Mark transaction success
        UPDATE Transactions
        SET Status = 'Success',
            RazorpayPaymentId = @RazorpayPaymentId,
            RazorpaySignature = @RazorpaySignature,
            UpdatedAt = GETUTCDATE()
        WHERE TransactionId = @TransactionId
          AND Status = 'Pending';
        
        IF @@ROWCOUNT = 0
            THROW 50001, 'Transaction not found or already processed', 1;
        
        -- 2. Create shop
        DECLARE @ShopId INT;
        INSERT INTO Shops (SellerId, PixelId, CityId, CategoryId, 
                           FloorNumber, RowLabel, Position,
                           StartDate, EndDate, DurationMonths, Status)
        SELECT @SellerId, @PixelId, CityId, CategoryId,
               FloorNumber, RowLabel, Position,
               @StartDate, DATEADD(MONTH, @DurationMonths, @StartDate),
               @DurationMonths, 'Active'
        FROM Pixels WHERE PixelId = @PixelId;
        
        SET @ShopId = SCOPE_IDENTITY();
        
        -- 3. Update pixel
        UPDATE Pixels
        SET Status = 'Sold',
            CurrentShopId = @ShopId,
            LockedBySellerId = NULL,
            LockExpiresAt = NULL,
            UpdatedAt = GETUTCDATE()
        WHERE PixelId = @PixelId;
        
        -- 4. Create draft ad
        INSERT INTO Ads (ShopId, SellerId, BusinessName, Status, IsLive)
        SELECT @ShopId, @SellerId, BusinessName, 'Draft', 0
        FROM Sellers WHERE SellerId = @SellerId;
        
        -- 5. Redeem points if any
        IF @PointsRedeemed > 0
        BEGIN
            UPDATE Sellers 
            SET PointsBalance = PointsBalance - @PointsRedeemed
            WHERE SellerId = @SellerId 
              AND PointsBalance >= @PointsRedeemed;
            
            IF @@ROWCOUNT = 0
                THROW 50002, 'Insufficient points balance', 1;
        END
        
        -- 6. Update transaction with shopId
        UPDATE Transactions 
        SET ShopId = @ShopId 
        WHERE TransactionId = @TransactionId;
        
        COMMIT TRANSACTION;
        
        SELECT @ShopId AS ShopId, 'Success' AS Result;
    END TRY
    BEGIN CATCH
        ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END;
11.2 Revenue Report Query
SQL
CREATE PROCEDURE sp_GetRevenueReport
    @CityId INT = NULL,
    @StateCode NVARCHAR(10) = NULL,
    @CategoryId INT = NULL,
    @FromDate DATE,
    @ToDate DATE,
    @GroupBy NVARCHAR(10) = 'day'  -- day | month | year
AS
BEGIN
    SELECT 
        CASE @GroupBy
            WHEN 'day'   THEN CAST(t.CreatedAt AS DATE)
            WHEN 'month' THEN DATEFROMPARTS(YEAR(t.CreatedAt), MONTH(t.CreatedAt), 1)
            WHEN 'year'  THEN DATEFROMPARTS(YEAR(t.CreatedAt), 1, 1)
        END AS Period,
        c.CityName,
        c.StateName,
        cat.CategoryName,
        COUNT(t.TransactionId) AS TransactionCount,
        SUM(t.BaseAmount) AS BaseRevenue,
        SUM(t.GstAmount) AS GstCollected,
        SUM(t.TotalAmount) AS TotalRevenue,
        SUM(t.PointsRedeemed) AS PointsRedeemed,
        AVG(t.TotalAmount) AS AvgTransactionValue
    FROM Transactions t
    INNER JOIN Shops s ON t.ShopId = s.ShopId
    INNER JOIN Cities c ON s.CityId = c.CityId
    INNER JOIN Categories cat ON s.CategoryId = cat.CategoryId
    WHERE t.Status = 'Success'
      AND CAST(t.CreatedAt AS DATE) BETWEEN @FromDate AND @ToDate
      AND (@CityId IS NULL OR s.CityId = @CityId)
      AND (@StateCode IS NULL OR c.StateCode = @StateCode)
      AND (@CategoryId IS NULL OR s.CategoryId = @CategoryId)
    GROUP BY 
        CASE @GroupBy
            WHEN 'day'   THEN CAST(t.CreatedAt AS DATE)
            WHEN 'month' THEN DATEFROMPARTS(YEAR(t.CreatedAt), MONTH(t.CreatedAt), 1)
            WHEN 'year'  THEN DATEFROMPARTS(YEAR(t.CreatedAt), 1, 1)
        END,
        c.CityName, c.StateName, cat.CategoryName
    ORDER BY Period DESC;
END;
