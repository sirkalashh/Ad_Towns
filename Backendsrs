// Runs every hour
public class StatsAggregationJob
{
    public async Task ExecuteAsync()
    {
        var targetDate = DateOnly.FromDateTime(DateTime.UtcNow);
        
        // Aggregate impressions into DailyStats (UPSERT)
        await _context.Database.ExecuteSqlRawAsync(@"
            MERGE DailyStats AS target
            USING (
                SELECT 
                    ShopId,
                    SellerId,
                    CAST(OccurredAt AS DATE) AS StatDate,
                    COUNT(*) AS TotalViews,
                    SUM(CASE WHEN ImpressionType = 'WhatsAppClick' THEN 1 ELSE 0 END) AS WA,
                    SUM(CASE WHEN ImpressionType = 'WebsiteClick' THEN 1 ELSE 0 END) AS WS,
                    SUM(CASE WHEN ImpressionType = 'OfferClick' THEN 1 ELSE 0 END) AS OC,
                    COUNT(DISTINCT BuyerIpHash) AS UV
                FROM Impressions
                WHERE CAST(OccurredAt AS DATE) = @today
                GROUP BY ShopId, SellerId, CAST(OccurredAt AS DATE)
            ) AS source
            ON target.ShopId = source.ShopId AND target.StatDate = source.StatDate
            WHEN MATCHED THEN UPDATE SET 
                TotalViews = source.TotalViews,
                TotalWhatsAppClicks = source.WA,
                TotalWebsiteClicks = source.WS,
                TotalOfferClicks = source.OC,
                UniqueVisitors = source.UV,
                UpdatedAt = GETUTCDATE()
            WHEN NOT MATCHED THEN INSERT 
                (ShopId, SellerId, StatDate, TotalViews, 
                 TotalWhatsAppClicks, TotalWebsiteClicks, 
                 TotalOfferClicks, UniqueVisitors)
            VALUES (source.ShopId, source.SellerId, source.StatDate,
                source.TotalViews, source.WA, source.WS, source.OC, source.UV);
        ", new SqlParameter("@today", targetDate));
    }
}
