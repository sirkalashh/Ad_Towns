public class PointsService
{
    public const int SELLER_TO_SELLER_POINTS = 50;
    public const int NON_SELLER_TO_SELLER_POINTS = 25;
    public const int WELCOME_BONUS_POINTS = 75;
    public const decimal POINTS_TO_INR_RATIO = 1.0m; // 1 point = ₹1
    
    public async Task AwardReferralPointsAsync(
        int referrerSellerId, int refereeSellerId,
        bool referrerWasSeller, int referralLinkId)
    {
        var points = referrerWasSeller 
            ? SELLER_TO_SELLER_POINTS 
            : NON_SELLER_TO_SELLER_POINTS;
        
        await using var transaction = await _context.BeginTransactionAsync();
        
        // Update balance atomically
        await _sellerRepo.IncrementPointsAsync(referrerSellerId, points);
        
        // Create ledger entry
        var newBalance = await _sellerRepo.GetPointsBalanceAsync(referrerSellerId);
        await _ledgerRepo.CreateAsync(new PointLedger
        {
            SellerId = referrerSellerId,
            PointsChange = points,
            BalanceAfter = newBalance,
            TransactionType = "Referral",
            ReferenceId = referralLinkId,
            ReferenceType = "ReferralLink",
            Description = $"Referral bonus — new seller joined"
        });
        
        // Update referral record
        await _referralRepo.MarkAwardedAsync(referralLinkId, points);
        
        await transaction.CommitAsync();
        
        // Notify referrer
        await _notificationService.SendAsync(referrerSellerId,
            "⭐ You earned points!",
            $"A seller you referred just joined AdTowns! +{points} points added.",
            "Points");
    }
    
    public async Task<bool> RedeemPointsAsync(
        int sellerId, int pointsToRedeem, 
        string purpose, out decimal monetaryValue)
    {
        monetaryValue = pointsToRedeem * POINTS_TO_INR_RATIO;
        
        var seller = await _sellerRepo.GetByIdAsync(sellerId);
        if (seller.PointsBalance < pointsToRedeem)
            return false;
        
        await _sellerRepo.DecrementPointsAsync(sellerId, pointsToRedeem);
        
        var newBalance = seller.PointsBalance - pointsToRedeem;
        await _ledgerRepo.CreateAsync(new PointLedger
        {
            SellerId = sellerId,
            PointsChange = -pointsToRedeem,
            BalanceAfter = newBalance,
            TransactionType = "Redemption",
            Description = $"Points redeemed for {purpose}"
        });
        
        return true;
    }
}
