2.2 Complete SQL Schema
Core Tables
SQL
-- =====================================================
-- CITIES
-- =====================================================
CREATE TABLE Cities (
    CityId          INT IDENTITY(1,1) PRIMARY KEY,
    CityName        NVARCHAR(100) NOT NULL,
    StateCode       NVARCHAR(10) NOT NULL,
    StateName       NVARCHAR(100) NOT NULL,
    IsMetro         BIT NOT NULL DEFAULT 0,
    IsTop10         BIT NOT NULL DEFAULT 0,
    IsActive        BIT NOT NULL DEFAULT 1,
    SortOrder       INT NOT NULL DEFAULT 999,
    Latitude        DECIMAL(10,8) NULL,
    Longitude       DECIMAL(11,8) NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_Cities_CityName UNIQUE (CityName)
);
 
CREATE INDEX IX_Cities_IsActive ON Cities(IsActive);
CREATE INDEX IX_Cities_IsTop10 ON Cities(IsTop10);
 
-- =====================================================
-- CATEGORIES
-- =====================================================
CREATE TABLE Categories (
    CategoryId      INT IDENTITY(1,1) PRIMARY KEY,
    CategoryName    NVARCHAR(100) NOT NULL,
    IconEmoji       NVARCHAR(10) NULL,
    IconUrl         NVARCHAR(500) NULL,
    IsGlobal        BIT NOT NULL DEFAULT 1,  -- applies to all cities
    SortOrder       INT NOT NULL DEFAULT 999,
    IsActive        BIT NOT NULL DEFAULT 1,
    CreatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
-- City-specific category overrides
CREATE TABLE CityCategories (
    CityCategoryId  INT IDENTITY(1,1) PRIMARY KEY,
    CityId          INT NOT NULL REFERENCES Cities(CityId),
    CategoryId      INT NOT NULL REFERENCES Categories(CategoryId),
    IsActive        BIT NOT NULL DEFAULT 1,
    SortOrder       INT NOT NULL DEFAULT 999,
    CreatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_CityCategories UNIQUE (CityId, CategoryId)
);
 
CREATE INDEX IX_CityCategories_CityId ON CityCategories(CityId);
 
-- =====================================================
-- FLOOR CONFIGURATIONS
-- =====================================================
CREATE TABLE FloorConfigurations (
    FloorConfigId   INT IDENTITY(1,1) PRIMARY KEY,
    CityId          INT NOT NULL REFERENCES Cities(CityId),
    CategoryId      INT NOT NULL REFERENCES Categories(CategoryId),
    FloorNumber     INT NOT NULL,              -- 1 = top (most expensive)
    FloorName       NVARCHAR(50) NOT NULL,     -- Platinum, Gold, Silver
    PixelsPerRow    INT NOT NULL DEFAULT 10,
    TotalRows       INT NOT NULL DEFAULT 1,
    BasePriceMonthly DECIMAL(10,2) NOT NULL,
    IsActive        BIT NOT NULL DEFAULT 1,
    CreatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_FloorConfig UNIQUE (CityId, CategoryId, FloorNumber)
);
 
CREATE INDEX IX_FloorConfig_CityCategory 
    ON FloorConfigurations(CityId, CategoryId);
 
-- =====================================================
-- PRICING RULES
-- =====================================================
CREATE TABLE PricingRules (
    PricingRuleId   INT IDENTITY(1,1) PRIMARY KEY,
    CityId          INT NULL REFERENCES Cities(CityId),  -- NULL = global
    CategoryId      INT NULL REFERENCES Categories(CategoryId),
    FloorNumber     INT NOT NULL,
    DurationMonths  INT NOT NULL,              -- 1, 3, 6, 12
    DiscountPercent DECIMAL(5,2) NOT NULL DEFAULT 0,
    OverridePrice   DECIMAL(10,2) NULL,        -- NULL = use floor base price
    GstPercent      DECIMAL(5,2) NOT NULL DEFAULT 18.00,
    IsActive        BIT NOT NULL DEFAULT 1,
    EffectiveFrom   DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    EffectiveTo     DATETIME2 NULL,
    CreatedAt       DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
-- =====================================================
-- SELLERS
-- =====================================================
CREATE TABLE Sellers (
    SellerId            INT IDENTITY(1,1) PRIMARY KEY,
    PhoneNumber         NVARCHAR(15) NOT NULL,
    PhoneVerified       BIT NOT NULL DEFAULT 0,
    BusinessName        NVARCHAR(200) NOT NULL,
    OwnerName           NVARCHAR(200) NOT NULL,
    Email               NVARCHAR(256) NULL,
    PrimaryCity         NVARCHAR(100) NULL,
    PrimaryCategory     NVARCHAR(100) NULL,
    
    -- Auth
    PasswordHash        NVARCHAR(500) NULL,
    RefreshToken        NVARCHAR(500) NULL,
    RefreshTokenExpiry  DATETIME2 NULL,
    LastLoginAt         DATETIME2 NULL,
    
    -- Status
    IsActive            BIT NOT NULL DEFAULT 1,
    IsBanned            BIT NOT NULL DEFAULT 0,
    BanReason           NVARCHAR(500) NULL,
    BanExpiresAt        DATETIME2 NULL,        -- NULL = permanent
    TimeoutUntil        DATETIME2 NULL,
    
    -- KYC
    IsGstVerified       BIT NOT NULL DEFAULT 0,
    IsIdentityVerified  BIT NOT NULL DEFAULT 0,
    IsVerifiedBadge     BIT NOT NULL DEFAULT 0,
    
    -- Profile
    Gstin               NVARCHAR(20) NULL,
    GstBusinessName     NVARCHAR(300) NULL,
    GstState            NVARCHAR(100) NULL,
    
    -- Points
    PointsBalance       INT NOT NULL DEFAULT 0,
    
    -- Referral
    ReferralCode        NVARCHAR(50) NOT NULL,
    ReferredBySellerId  INT NULL REFERENCES Sellers(SellerId),
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_Sellers_Phone UNIQUE (PhoneNumber),
    CONSTRAINT UQ_Sellers_ReferralCode UNIQUE (ReferralCode)
);
 
CREATE INDEX IX_Sellers_Phone ON Sellers(PhoneNumber);
CREATE INDEX IX_Sellers_IsActive ON Sellers(IsActive, IsBanned);
CREATE INDEX IX_Sellers_ReferralCode ON Sellers(ReferralCode);
 
-- =====================================================
-- PIXELS
-- =====================================================
CREATE TABLE Pixels (
    PixelId             INT IDENTITY(1,1) PRIMARY KEY,
    CityId              INT NOT NULL REFERENCES Cities(CityId),
    CategoryId          INT NOT NULL REFERENCES Categories(CategoryId),
    FloorNumber         INT NOT NULL,
    RowLabel            NVARCHAR(5) NOT NULL,    -- A, B, C...
    Position            INT NOT NULL,            -- 1-10
    
    -- Status
    Status              NVARCHAR(20) NOT NULL DEFAULT 'Available',
    -- Available | Locked | Sold | Ghost | Inactive
    
    -- Lock (Redis-backed but also stored for recovery)
    LockedBySellerId    INT NULL REFERENCES Sellers(SellerId),
    LockExpiresAt       DATETIME2 NULL,
    
    -- Current shop
    CurrentShopId       INT NULL,  -- FK added after Shops table
    
    -- Ghost pixel
    IsGhost             BIT NOT NULL DEFAULT 0,
    GhostImageUrl       NVARCHAR(500) NULL,
    GhostRedirectUrl    NVARCHAR(500) NULL,
    
    -- Bidding
    IsBiddable          BIT NOT NULL DEFAULT 0,
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_Pixel_Position UNIQUE (CityId, CategoryId, FloorNumber, RowLabel, Position)
);
 
CREATE INDEX IX_Pixels_CityCategory 
    ON Pixels(CityId, CategoryId, FloorNumber);
CREATE INDEX IX_Pixels_Status ON Pixels(Status);
CREATE INDEX IX_Pixels_CurrentShop ON Pixels(CurrentShopId);
 
-- =====================================================
-- SHOPS (A seller's pixel purchase = a Shop)
-- =====================================================
CREATE TABLE Shops (
    ShopId              INT IDENTITY(1,1) PRIMARY KEY,
    SellerId            INT NOT NULL REFERENCES Sellers(SellerId),
    PixelId             INT NOT NULL REFERENCES Pixels(PixelId),
    
    -- Location context (denormalized for query performance)
    CityId              INT NOT NULL REFERENCES Cities(CityId),
    CategoryId          INT NOT NULL REFERENCES Categories(CategoryId),
    FloorNumber         INT NOT NULL,
    RowLabel            NVARCHAR(5) NOT NULL,
    Position            INT NOT NULL,
    
    -- Validity
    StartDate           DATETIME2 NOT NULL,
    EndDate             DATETIME2 NOT NULL,
    DurationMonths      INT NOT NULL,
    
    -- Status
    Status              NVARCHAR(20) NOT NULL DEFAULT 'Active',
    -- Active | Expired | Suspended | Deleted
    
    -- Admin actions
    DeactivatedAt       DATETIME2 NULL,
    DeactivatedBy       INT NULL,              -- AdminId
    DeactivationReason  NVARCHAR(500) NULL,
    DeletedAt           DATETIME2 NULL,
    DeletedBy           INT NULL,
    RefundAmount        DECIMAL(10,2) NULL,
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
CREATE INDEX IX_Shops_Seller ON Shops(SellerId);
CREATE INDEX IX_Shops_Pixel ON Shops(PixelId);
CREATE INDEX IX_Shops_Status ON Shops(Status, EndDate);
CREATE INDEX IX_Shops_EndDate ON Shops(EndDate);  -- for expiry jobs
 
-- Add FK back to Pixels
ALTER TABLE Pixels 
ADD CONSTRAINT FK_Pixels_CurrentShop 
FOREIGN KEY (CurrentShopId) REFERENCES Shops(ShopId);
 
-- =====================================================
-- ADS (The creative content of a shop)
-- =====================================================
CREATE TABLE Ads (
    AdId                INT IDENTITY(1,1) PRIMARY KEY,
    ShopId              INT NOT NULL REFERENCES Shops(ShopId),
    SellerId            INT NOT NULL REFERENCES Sellers(SellerId),
    
    -- Creative
    ImageUrl            NVARCHAR(500) NULL,
    ImageThumbnailUrl   NVARCHAR(500) NULL,
    FrameId             INT NULL REFERENCES Frames(FrameId),
    
    BusinessName        NVARCHAR(200) NOT NULL,
    Headline            NVARCHAR(60) NULL,
    Description         NVARCHAR(100) NULL,
    
    -- CTA
    CtaType             NVARCHAR(20) NOT NULL DEFAULT 'WhatsApp',
    -- WhatsApp | Website | Both
    WhatsAppNumber      NVARCHAR(15) NULL,
    WebsiteUrl          NVARCHAR(500) NULL,
    
    -- Status
    Status              NVARCHAR(20) NOT NULL DEFAULT 'Draft',
    -- Draft | Live | Paused | Archived
    IsLive              BIT NOT NULL DEFAULT 0,
    PublishedAt         DATETIME2 NULL,
    
    -- AI generated
    IsAiGenerated       BIT NOT NULL DEFAULT 0,
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
CREATE INDEX IX_Ads_ShopId ON Ads(ShopId);
CREATE INDEX IX_Ads_IsLive ON Ads(IsLive, Status);
 
-- =====================================================
-- FRAMES (Ad frame templates)
-- =====================================================
CREATE TABLE Frames (
    FrameId             INT IDENTITY(1,1) PRIMARY KEY,
    FrameName           NVARCHAR(100) NOT NULL,
    FrameType           NVARCHAR(20) NOT NULL,
    -- Standard | Festival | Weather | Seasonal
    ImageUrl            NVARCHAR(500) NOT NULL,
    ThumbnailUrl        NVARCHAR(500) NOT NULL,
    IsFree              BIT NOT NULL DEFAULT 1,
    Price               DECIMAL(10,2) NOT NULL DEFAULT 0,
    FestivalTag         NVARCHAR(50) NULL,    -- Diwali, Holi, etc.
    WeatherTag          NVARCHAR(50) NULL,    -- Summer, Monsoon, etc.
    IsActive            BIT NOT NULL DEFAULT 1,
    SortOrder           INT NOT NULL DEFAULT 999,
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
-- =====================================================
-- CARDS (Premium larger ad units between floors)
-- =====================================================
CREATE TABLE Cards (
    CardId              INT IDENTITY(1,1) PRIMARY KEY,
    CityId              INT NOT NULL REFERENCES Cities(CityId),
    CategoryId          INT NOT NULL REFERENCES Categories(CategoryId),
    AfterFloorNumber    INT NOT NULL,   -- Card appears after this floor
    Position            INT NOT NULL DEFAULT 1,  -- Multiple cards per gap
    
    Status              NVARCHAR(20) NOT NULL DEFAULT 'Available',
    CurrentShopId       INT NULL REFERENCES Shops(ShopId),
    SellerId            INT NULL REFERENCES Sellers(SellerId),
    
    BasePriceMonthly    DECIMAL(10,2) NOT NULL,
    StartDate           DATETIME2 NULL,
    EndDate             DATETIME2 NULL,
    
    IsActive            BIT NOT NULL DEFAULT 1,
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_Card_Position UNIQUE (CityId, CategoryId, AfterFloorNumber, Position)
);
 
-- =====================================================
-- OFFERS (Today's Offer — 24hr cycle)
-- =====================================================
CREATE TABLE Offers (
    OfferId             INT IDENTITY(1,1) PRIMARY KEY,
    ShopId              INT NOT NULL REFERENCES Shops(ShopId),
    SellerId            INT NOT NULL REFERENCES Sellers(SellerId),
    
    -- Offer content
    OfferHeadline       NVARCHAR(60) NOT NULL,
    OfferDetails        NVARCHAR(100) NULL,
    CtaType             NVARCHAR(20) NOT NULL DEFAULT 'WhatsApp',
    CtaLink             NVARCHAR(500) NULL,
    WhatsAppNumber      NVARCHAR(15) NULL,
    
    -- Limit
    HasLimit            BIT NOT NULL DEFAULT 0,
    RedemptionLimit     INT NULL,
    RedemptionsUsed     INT NOT NULL DEFAULT 0,
    
    -- Timing (IST — 8AM to next 8AM)
    OfferDate           DATE NOT NULL,   -- The day this offer is for
    StartsAt            DATETIME2 NOT NULL,
    ExpiresAt           DATETIME2 NOT NULL,
    
    -- Status
    Status              NVARCHAR(20) NOT NULL DEFAULT 'Scheduled',
    -- Scheduled | Active | Paused | Ended | Expired | LimitReached
    IsActive            BIT NOT NULL DEFAULT 0,
    ActivatedAt         DATETIME2 NULL,
    EndedAt             DATETIME2 NULL,
    EndedBy             NVARCHAR(20) NULL,  -- Seller | System | Limit
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
CREATE INDEX IX_Offers_ShopId ON Offers(ShopId);
CREATE INDEX IX_Offers_Active ON Offers(IsActive, ExpiresAt);
CREATE INDEX IX_Offers_OfferDate ON Offers(OfferDate, Status);
 
-- =====================================================
-- TRANSACTIONS
-- =====================================================
CREATE TABLE Transactions (
    TransactionId       INT IDENTITY(1,1) PRIMARY KEY,
    SellerId            INT NOT NULL REFERENCES Sellers(SellerId),
    ShopId              INT NULL REFERENCES Shops(ShopId),
    
    -- Razorpay
    RazorpayOrderId     NVARCHAR(100) NULL,
    RazorpayPaymentId   NVARCHAR(100) NULL,
    RazorpaySignature   NVARCHAR(500) NULL,
    
    -- Amounts
    BaseAmount          DECIMAL(10,2) NOT NULL,
    DiscountAmount      DECIMAL(10,2) NOT NULL DEFAULT 0,
    PointsRedeemedAmt   DECIMAL(10,2) NOT NULL DEFAULT 0,
    PointsRedeemed      INT NOT NULL DEFAULT 0,
    TaxableAmount       DECIMAL(10,2) NOT NULL,
    GstAmount           DECIMAL(10,2) NOT NULL,
    TotalAmount         DECIMAL(10,2) NOT NULL,
    
    -- Type
    TransactionType     NVARCHAR(30) NOT NULL,
    -- NewPixel | Renewal | Upgrade | Card | BidWin | FramePurchase
    
    -- Status
    Status              NVARCHAR(20) NOT NULL DEFAULT 'Pending',
    -- Pending | Success | Failed | Refunded | PartialRefund
    
    FailureReason       NVARCHAR(500) NULL,
    RefundAmount        DECIMAL(10,2) NULL,
    RefundedAt          DATETIME2 NULL,
    RefundReason        NVARCHAR(500) NULL,
    
    -- GST
    SellerGstin         NVARCHAR(20) NULL,
    InvoiceId           INT NULL,  -- FK added after Invoices
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    UpdatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE()
);
 
CREATE INDEX IX_Transactions_Seller ON Transactions(SellerId);
CREATE INDEX IX_Transactions_Razorpay ON Transactions(RazorpayOrderId);
CREATE INDEX IX_Transactions_Status ON Transactions(Status);
 
-- =====================================================
-- INVOICES
-- =====================================================
CREATE TABLE Invoices (
    InvoiceId           INT IDENTITY(1,1) PRIMARY KEY,
    InvoiceNumber       NVARCHAR(50) NOT NULL,  -- INV-2025-000001
    TransactionId       INT NOT NULL REFERENCES Transactions(TransactionId),
    SellerId            INT NOT NULL REFERENCES Sellers(SellerId),
    
    -- Invoice details
    InvoiceDate         DATE NOT NULL,
    Description         NVARCHAR(500) NOT NULL,
    
    -- Amounts (snapshot at time of invoice)
    BaseAmount          DECIMAL(10,2) NOT NULL,
    DiscountAmount      DECIMAL(10,2) NOT NULL DEFAULT 0,
    TaxableAmount       DECIMAL(10,2) NOT NULL,
    CgstAmount          DECIMAL(10,2) NOT NULL DEFAULT 0,
    SgstAmount          DECIMAL(10,2) NOT NULL DEFAULT 0,
    IgstAmount          DECIMAL(10,2) NOT NULL DEFAULT 0,
    TotalAmount         DECIMAL(10,2) NOT NULL,
    
    -- GST info snapshot
    BuyerGstin          NVARCHAR(20) NULL,
    BuyerGstName        NVARCHAR(300) NULL,
    BuyerState          NVARCHAR(100) NULL,
    
    -- PDF
    PdfUrl              NVARCHAR(500) NULL,
    
    CreatedAt           DATETIME2 NOT NULL DEFAULT GETUTCDATE(),
    
    CONSTRAINT UQ_Invoices_Number UNIQUE (InvoiceNumber)
);
 
ALTER TABLE Transactions 
ADD CONSTRAINT FK_Transactions_Invoice 
